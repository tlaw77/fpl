{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tlaw77.github.io/fpl/spec/schemas/effective-squad.schema.json",
  "title": "FPL Effective Squad",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "target_gw", "generated_at_utc", "data"],
  "properties": {
    "schema": {"const": "fpl.effective-squad"},
    "schema_version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["success", "partial", "degraded", "failed"]},
    "target_gw": {"type": "integer", "minimum": 1, "maximum": 38},
    "truth_state": {"const": "derived_current"},
    "source_captured_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "basis", "players", "bank_tenths", "free_transfers_before", "free_transfers_used", "free_transfers_remaining", "hit_already_incurred", "next_transfer_cost", "legality"],
      "properties": {
        "entry_id": {"type": "integer", "minimum": 1},
        "basis": {"enum": ["official", "official_plus_declared", "official_plus_declared_plus_working"]},
        "official_squad_capture": {"type": ["string", "null"], "format": "date-time"},
        "applied_action_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "working_plan_id": {"type": ["string", "null"]},
        "players": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "items": {"$ref": "#/$defs/player"}
        },
        "bank_tenths": {"type": "integer", "minimum": 0},
        "free_transfers_before": {"type": "integer", "minimum": 0, "maximum": 5},
        "free_transfers_used": {"type": "integer", "minimum": 0},
        "free_transfers_remaining": {"type": "integer", "minimum": 0, "maximum": 5},
        "hit_already_incurred": {"type": "integer", "minimum": 0, "multipleOf": 4},
        "next_transfer_cost": {"enum": [0, 4]},
        "legality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid", "violations"],
          "properties": {
            "valid": {"type": "boolean"},
            "violations": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  },
  "$defs": {
    "player": {
      "type": "object",
      "additionalProperties": true,
      "required": ["player_id", "position_id", "club_id", "price_tenths"],
      "properties": {
        "player_id": {"type": "integer", "minimum": 1},
        "position_id": {"type": "integer", "minimum": 1, "maximum": 4},
        "club_id": {"type": "integer", "minimum": 1},
        "price_tenths": {"type": "integer", "minimum": 0},
        "source_action_id": {"type": ["string", "null"]}
      }
    }
  }
}
